# Plantilla de secretos de despliegue.
#
# Copiar a `.env` (`./deploy.sh setup` lo hace) y rellenar. El `.env` real NO se
# versiona: hasta 2026-08-20 estos valores vivían en claro dentro de
# `docker-compose.yml`, que sí está en el repositorio, así que el secreto de firma de
# sesión y la contraseña de la cuenta maestra eran públicos para cualquiera con
# acceso al repo. Los valores anteriores están quemados y no deben reutilizarse.
#
# Generar cada secreto por separado, nunca a mano:
#   JWT_SECRET / REDIS_PASSWORD   →  openssl rand -hex 32
#   POSTGRES_PASSWORD             →  openssl rand -base64 24
#
# @see 3-seguridad-del-proyecto.md §4.1 (qué es público y qué es secreto)

# --- Base de datos ---
POSTGRES_DB=olo_db
POSTGRES_USER=olo_user
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=

# --- Firma de sesión ---
# Rotarla cierra todas las sesiones abiertas: los JWT ya emitidos dejan de validar.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Cuenta maestra local: SOLO desarrollo ---
# La API la desactiva sola cuando NODE_ENV=production (ver `config/index.ts`), y
# `docker-compose.prod.yml` ya no le pasa estas variables. Dejarlas aquí vacías en
# un despliegue real es lo correcto.
LOCAL_AUTH_EMAIL=
LOCAL_AUTH_PASSWORD=
LOCAL_AUTH_NAME=Superadmin
LOCAL_AUTH_ROLE=Superadmin

# --- Dominios (solo producción) ---
SITIO_WEB_DOMAIN=
INTRANET_DOMAIN=
