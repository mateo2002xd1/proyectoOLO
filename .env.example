# Plantilla de secretos de despliegue.
#
# Copiar a `.env` (`./deploy.sh setup` lo hace) y rellenar. El `.env` real NO se
# versiona: hasta 2026-08-20 estos valores vivían en claro dentro del
# `docker-compose.yml` de entonces, que sí estaba en el repositorio, así que el secreto de firma de
# sesión y la contraseña de la cuenta maestra eran públicos para cualquiera con
# acceso al repo. Los valores anteriores están quemados y no deben reutilizarse.
#
# Generar cada secreto por separado, nunca a mano:
#   JWT_SECRET / REDIS_PASSWORD   →  openssl rand -hex 32
#   POSTGRES_PASSWORD             →  openssl rand -base64 24
#
# @see 3-seguridad-del-proyecto.md §4.1 (qué es público y qué es secreto)

# --- Base de datos ---
POSTGRES_DB=olo_db
POSTGRES_USER=olo_user
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=

# --- Firma de sesión ---
# Rotarla cierra todas las sesiones abiertas: los JWT ya emitidos dejan de validar.
JWT_SECRET=
# Una jornada, como el valor por defecto de la API (`config/index.ts`) y la cookie de
# sesión del sitio. Estaba en 7d: un token robado servía una semana.
JWT_EXPIRES_IN=8h

# --- Direcciones públicas del túnel ---
# Las URL completas que da el túnel para cada puerta de nginx: 8080 el sitio, 8081 la
# intranet. `https://`, sin barra final. Quedan dentro del código que descarga el
# navegador al construir: si cambian, hay que volver a construir (`deploy.sh build`).
SITIO_WEB_URL_PUBLICA=
INTRANET_URL_PUBLICA=

# --- Base de origen para `deploy.sh importar` (temporal) ---
# Conexión a la base de donde se copian los datos (la de Neon). Solo la usa `importar`:
# bórrala en cuanto termines, es la clave de esa base.
ORIGEN_DATABASE_URL=

# --- Revalidación de caché al publicar ---
# Secreto que comparten la API y el sitio web para la ruta interna POST /api/revalidar,
# con la que la API le pide al sitio que tire su caché al aprobar una página (guía §3.4).
# Aquí solo está para que docker-compose lo inyecte a los dos contenedores.
# Generar con: openssl rand -hex 32 (uno propio, NO reutilizar JWT_SECRET).
REVALIDAR_SECRET=
