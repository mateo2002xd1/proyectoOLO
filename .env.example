# ============================================================
# CONFIGURACIÓN DE PRODUCCIÓN - OLO PROYECT
# ============================================================
# Copiar este archivo a .env y completar con los valores reales
# NUNCA commitear el archivo .env a git
# ============================================================

# ── Dominios ─────────────────────────────────────────────────
# Dominios del sitio web y la intranet (sin https://)
SITIO_WEB_DOMAIN=tusitio.com
INTRANET_DOMAIN=intranet.tusitio.com

# ── Base de datos PostgreSQL ─────────────────────────────────
POSTGRES_DB=olo_db
POSTGRES_USER=olo_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_123

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_456

# ── JWT Secrets (OBLIGATORIOS) ──────────────────────────────
# Generar con: openssl rand -hex 32
JWT_SECRET=GENERAR_SECRET_AQUI
JWT_SITE_SECRET=GENERAR_OTRO_SECRET_AQUI
JWT_EXPIRES_IN=7d

# ── Auth Local (Superadmin) ─────────────────────────────────
LOCAL_AUTH_EMAIL=admin@tusitio.com
LOCAL_AUTH_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
LOCAL_AUTH_NAME=Superadmin
LOCAL_AUTH_ROLE=Superadmin
