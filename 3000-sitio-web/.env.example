# Plantilla de variables del sitio web. Copiar a `.env.local` y rellenar.
# En Docker no se usa: los valores llegan por `environment:` del docker-compose.

# Secreto compartido con la API (`REVALIDAR_SECRET` en api-backend). Autentica la ruta
# interna `POST /api/revalidar`, que la API llama al aprobar una página para que el sitio
# tire su copia cacheada en vez de servir la versión anterior hasta que caduque.
#
# Sin este valor la ruta responde 503 y no revalida: aprobar sigue publicando bien, pero
# el cambio tarda en verse lo que diga el `revalidate` de cada fetch.
#
# Debe ser EL MISMO valor en las dos aplicaciones. Generar con: openssl rand -hex 32
REVALIDAR_SECRET=

# Mismo valor que JWT_SECRET de api-backend/.env: la API firma el token de sesión y este
# servidor verifica esa firma en sus route handlers (p. ej. POST /api/upload) con
# `jwtVerify`. Sin este valor, cualquier operación que lo use falla con 401 aunque la
# sesión en el navegador parezca activa (el middleware solo decodifica, no verifica).
#
# Copiar el valor tal cual de tu api-backend/.env local — no generar uno nuevo aquí.
JWT_SECRET=

# API pública de consulta CNO/CUOC (ver API_PUBLICA_CONSULTA.md en la raíz). La usa el
# buscador de ocupaciones a través de /api/ocupaciones: el navegador llama al sitio y el
# sitio añade la llave, así que NUNCA debe llevar el prefijo NEXT_PUBLIC_.
#
# La llave se recibe por un canal aparte (no por correo ni chat abierto). Sin ella el
# buscador responde "No se pudo consultar el catálogo de ocupaciones".
CNO_API_URL=https://oloserver.tail033823.ts.net
CNO_API_KEY=
