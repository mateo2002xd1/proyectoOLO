# En Windows, crear symlinks requiere privilegios de administrador o el "modo
# desarrollador" activado. Sin eso, npm falla en silencio al enlazar las
# dependencias locales "file:../packages/*" y deja carpetas vacías en
# node_modules/@olo (provocando "Module not found"). install-links=true hace
# que npm copie el contenido en vez de crear un symlink, evitando el problema.
install-links=true
