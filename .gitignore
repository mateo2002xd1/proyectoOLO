# ── Dependencias y compilados ──────────────────────────────────────────────────
node_modules/
.next/
out/
build/
dist/
coverage/
.turbo/
*.tsbuildinfo

# ── Variables de entorno y secretos ────────────────────────────────────────────
.env
.env.local
.env.*
!.env.example

# ── Logs ───────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-error.log*

# ── SQL ────────────────────────────────────────────────────────────────────────
# Todo .sql se ignora porque puede ser un volcado con datos reales. Se rescata lo
# que es código del proyecto:
*.sql
# La semilla de contenido: hace que una instalación nueva arranque con las páginas
# cargadas. No lleva usuarios, bitácora ni datos personales. Se regenera con
# `npm run seed:generar` desde 4000-api-backend/.
!4000-api-backend/seed/*.sql
# Los pasos de `deploy.sh importar`. El volcado importacion_*.sql que ese comando
# deja si algo falla sigue ignorado.
!docker/sql/*.sql
# El esquema de antes de las migraciones. Ya no se aplica, pero se conserva como
# historia; sin esta línea, `*.sql` lo sacaría del repositorio.
!4000-api-backend/src/infrastructure/db/migrations/_obsoletas/script.sql

# ── Asistentes de IA ───────────────────────────────────────────────────────────
.agent/
.agents/
openspec/
# .claude/ no se versiona: ajustes, permisos, skills y el auditor (/auditar) son de
# cada quien y se quedan en su máquina.
.claude/
# Los informes de /auditar son privados de quien los genera.
auditorias/

# ── Carpetas con el nombre de antes ────────────────────────────────────────────
# Las apps se llaman `3000-sitio-web`, `3001-intranet` y `4000-api-backend` desde el
# 2026-09-25. Tras el `git pull` de ese cambio, en cada PC queda la carpeta vieja con
# lo que Git no muda (.env, archivos subidos, node_modules). `npm run dev` lo trae y
# deja CARPETA-MUDADA.txt; sin estas líneas, un `git add .` volvería a subirla.
/sitio-web/
/intranet/
/api-backend/

# ── Trabajo local que no es del proyecto ───────────────────────────────────────
deprecated/
test/

