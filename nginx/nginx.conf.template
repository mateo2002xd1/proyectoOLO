# PLANTILLA, no configuracion final. La imagen `nginx:alpine` sustituye los
# ${PLACEHOLDER} de /etc/nginx/templates/*.template al arrancar y escribe el
# resultado donde diga NGINX_ENVSUBST_OUTPUT_DIR (ver docker-compose.prod.yml).
#
# Antes este archivo se montaba tal cual como /etc/nginx/nginx.conf, asi que
# `server_name ${SITIO_WEB_DOMAIN};` llegaba literal: nginx arrancaba sin quejarse
# pero ese bloque no casaba con ningun dominio real y todo caia en el server por
# defecto. NGINX_ENVSUBST_FILTER limita la sustitucion a esas dos variables, para
# que las propias de nginx ($host, $remote_addr, $binary_remote_addr...) se queden
# intactas.
events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # Logs
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;
    error_log  /var/log/nginx/error.log warn;

    # Configuraciones de rendimiento
    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    client_max_body_size 10M;

    # ── Límites de tasa ─────────────────────────────────────────────────────
    #
    # Barrera volumétrica delante de Node. No sustituye a los límites de la API
    # —esos cuentan por usuario o por correo, que es lo que de verdad hay que
    # proteger— sino que evita que el proceso llegue siquiera a ver una inundación.
    #
    # Aquí $binary_remote_addr SÍ es la IP del visitante: nginx es el primer salto,
    # así que no hay cabecera que falsificar. Por eso este control vive aquí y no
    # solo en Express.
    #
    # 20 r/s con ráfaga de 40 es holgado para navegar —una pantalla del panel dispara
    # varias peticiones a la vez— y estrecho para un bucle automatizado.
    limit_req_zone  $binary_remote_addr zone=api_general:10m rate=20r/s;
    limit_conn_zone $binary_remote_addr zone=conexiones:10m;
    limit_req_status  429;
    limit_conn_status 429;

    # Gzip
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss application/atom+xml image/svg+xml;

    # ── Reparto de prefijos: /api-backend/ es Express, /api/ es Next ────────
    #
    # Antes TODO /api/ iba a Express, y eso tumbaba el panel entero: sitio-web tiene
    # diecinueve rutas propias bajo ese prefijo (/api/auth/login, /api/upload,
    # /api/users, /api/roles...) que Express no conoce, así que respondían 404 —
    # incluida la de iniciar sesión. Ahora la API vive bajo /api-backend/, que es el
    # prefijo que la intranet ya usaba, y /api/ queda para cada aplicación.
    #
    # Al cambiar el prefijo hay que mover con él la baseURL de los clientes del sitio:
    # `NEXT_PUBLIC_API_URL` pasa a incluir /api-backend en los docker-compose. Se inyecta
    # como ARG del build porque Next incrusta las NEXT_PUBLIC_* en el bundle del
    # navegador al compilar; ponerla solo en `environment:` no tendría efecto.
    #
    # PENDIENTE, sin relación con lo anterior: la política de subida admite documentos
    # de hasta 50 MB y client_max_body_size está en 10M, así que nginx los cortaría
    # antes. Hay que igualar los dos números en la dirección que se decida.
    # Upstreams
    upstream sitio_web {
        server sitio-web:3000;
    }

    upstream intranet {
        server intranet:3001;
    }

    upstream api_backend {
        server api-backend:4000;
    }

    # HTTP -> HTTPS redirect
    server {
        listen 80;
        server_name _;

        # Let's Encrypt challenge
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # Sitio Web (HTTPS)
    server {
        listen 443 ssl http2;
        server_name ${SITIO_WEB_DOMAIN};

        # SSL (Let's Encrypt)
        ssl_certificate     /etc/letsencrypt/live/${SITIO_WEB_DOMAIN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${SITIO_WEB_DOMAIN}/privkey.pem;

        # SSL Security
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
        ssl_prefer_server_ciphers off;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;

        # Security Headers
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        # API proxy -- bajo /api-backend/, no bajo /api/
        #
        # /api/ se queda para las rutas propias de Next del sitio: /api/auth/login,
        # /api/upload, /api/users... son diecinueve, e incluyen el login del panel.
        # Mandarlas a Express era un 404 garantizado: no las conoce.
        #
        # La barra final de proxy_pass es la que quita el prefijo: /api-backend/api/paginas
        # llega a Express como /api/paginas, que es lo que los clientes del sitio piden
        # (todos anteponen /api a la ruta, sobre la baseURL NEXT_PUBLIC_API_URL).
        location /api-backend/ {
            limit_req  zone=api_general burst=40 nodelay;
            limit_conn conexiones 20;

            proxy_pass http://api_backend/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }

        # Sitio Web
        location / {
            proxy_pass http://sitio_web;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }
    }

    # Intranet (HTTPS)
    server {
        listen 443 ssl http2;
        server_name ${INTRANET_DOMAIN};

        # SSL (Let's Encrypt)
        ssl_certificate     /etc/letsencrypt/live/${INTRANET_DOMAIN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${INTRANET_DOMAIN}/privkey.pem;

        # SSL Security
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
        ssl_prefer_server_ciphers off;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;

        # Security Headers
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        # API proxy -- bajo /api-backend/, no bajo /api/
        #
        # Igual que en el sitio: /api/ se reserva para las rutas propias de Next (la
        # intranet tiene su /api/upload). La diferencia esta en el proxy_pass: el cliente
        # de la intranet pide /api-backend/paginas/... SIN el /api, asi que aqui se anade.
        # Es la misma traduccion que ya hacia el rewrite de su next.config.ts, hecha un
        # salto antes.
        location /api-backend/ {
            limit_req  zone=api_general burst=40 nodelay;
            limit_conn conexiones 20;

            proxy_pass http://api_backend/api/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }

        # Intranet
        location / {
            proxy_pass http://intranet;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }
    }
}
