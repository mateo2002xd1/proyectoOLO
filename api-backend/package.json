{
  "name": "@olo/api-backend",
  "version": "1.0.0",
  "description": "API Backend - Observatorio Laboral y Ocupacional (OLO)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "ts-node scripts/migrate.ts up",
    "migrate:status": "ts-node scripts/migrate.ts status",
    "migrate:down": "ts-node scripts/migrate.ts down",
    "db:verificar": "ts-node scripts/verificar-esquema.ts",
    "ambito:auditar": "ts-node scripts/auditar-ambito.ts",
    "ambito:verificar": "ts-node scripts/verificar-ambito.ts",
    "permisos:verificar": "ts-node scripts/verificar-permisos.ts",
    "propiedad:verificar": "ts-node scripts/verificar-propiedad.ts",
    "sembrar:permisos": "ts-node scripts/sembrar-permisos-roles.ts",
    "auditoria:verificar": "ts-node scripts/verificar-auditoria.ts",
    "password:verificar": "ts-node scripts/verificar-politica-password.ts",
    "sembrar:tasa": "ts-node scripts/sembrar-pagina-tasa.ts",
    "sembrar:intranet": "ts-node scripts/sembrar-paginas-intranet.ts",
    "migrar:plantilla": "ts-node scripts/migrar-plantilla-intranet.ts",
    "sembrar:plantilla:sitio": "ts-node scripts/sembrar-plantilla-sitio.ts",
    "respaldo": "ts-node scripts/respaldo.ts",
    "email:verificar": "ts-node scripts/verificar-politica-email.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@olo/accessibility-policy": "file:../packages/accessibility-policy",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dompurify": "^3.4.13",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "ws": "^8.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
