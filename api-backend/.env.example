# Environment Variables - API Backend OLO
# Copiar este archivo a .env y completar los valores

# Puerto del servidor
PORT=4000

# Base de datos PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/olo_db

# JWT Secrets (OBLIGATORIOS - sin fallback)
JWT_SECRET=tu-jwt-secret-aqui
JWT_SITE_SECRET=tu-jwt-site-secret-aqui

# Redis
REDIS_URL=redis://localhost:6379

# Entorno
NODE_ENV=development

# Si es 'true', sequelize.sync() altera columnas existentes al arrancar.
# Dejar sin definir (false) salvo que DATABASE_URL apunte a una BD local propia
# — DATABASE_URL puede apuntar a una BD compartida (ej. Neon).
DB_AUTO_ALTER=false

# URLs
FRONTEND_URL=http://localhost:3000
INTRANET_URL=http://localhost:3001
