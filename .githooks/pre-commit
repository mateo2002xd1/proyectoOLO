#!/bin/sh
# Antes de cada commit: regenera docs/13-mapa-del-proyecto.md con lo que está en staging
# (no con el árbol de trabajo) y lo mete en el mismo commit. Así el mapa cambia en el
# commit que cambió la estructura, y su diff dice qué carpeta, librería o ruta entró.
#
# El mapa nunca bloquea un commit: es un plano, no un control. La única excepción es lo de
# abajo: nada de `auditorias/` entra a un commit.

# Los informes de /auditar son privados de quien los genera (`auditorias/` está en
# .gitignore). El .gitignore no basta: no frena un `git add -f` ni un archivo que ya estaba
# rastreado. Borrarlos del índice (dejar de rastrearlos) sí se permite.
prohibidos=$(git diff --cached --name-only --diff-filter=ACMR -- auditorias)
if [ -n "$prohibidos" ]; then
  echo "COMMIT BLOQUEADO: auditorias/ es privada y no se sube a GitHub:" >&2
  echo "$prohibidos" | sed "s/^/  /" >&2
  echo "Sácalos del commit con: git restore --staged auditorias" >&2
  echo "Si ya estaban rastreados: git rm -r --cached auditorias" >&2
  exit 1
fi

# `git commit -- rutas` arma un índice temporal solo con esas rutas; añadir el mapa ahí
# lo dejaría descuadrado con el índice real. En ese caso se salta y lo pone al día el
# siguiente commit normal.
case "$GIT_INDEX_FILE" in
  *next-index*)
    echo "mapa: commit de rutas sueltas; el mapa se pone al día en el próximo commit."
    exit 0
    ;;
esac

if ! command -v node >/dev/null 2>&1; then
  echo "mapa: no se encontró node; el mapa no se regeneró."
  exit 0
fi

node scripts/mapa/generar-mapa.mjs --desde index --hook || {
  echo "mapa: no se pudo regenerar; el commit sigue igual."
  exit 0
}
git add docs/13-mapa-del-proyecto.md
exit 0
