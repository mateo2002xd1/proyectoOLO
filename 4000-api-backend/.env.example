# Variables de entorno - API Backend - Sistema de control de contenidos OLO
# Copiar este archivo a .env y completar los valores

# Puerto del servidor
PORT=4000

# Interfaz en la que escucha. 127.0.0.1 por defecto (solo este equipo); dentro de
# Docker tiene que ser 0.0.0.0, y docker-compose.servidor.yml ya la pone.
HOST=127.0.0.1

# Base de datos PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/olo_db

# SSL con Postgres (no afecta a Neon, que usa su propio driver). Va activo salvo que
# aquí diga exactamente 'false', que es lo que necesita un Postgres local o el de Docker.
DB_SSL=false

# JWT Secrets (OBLIGATORIOS - sin fallback)
JWT_SECRET=tu-jwt-secret-aqui

# Vida del token. 8h por defecto (una jornada); tiene que ir a la par del
# COOKIE_MAX_AGE del login del sitio (3000-sitio-web/src/app/api/auth/login/route.ts).
JWT_EXPIRES_IN=8h

# Redis
REDIS_URL=redis://localhost:6379

# Entorno
NODE_ENV=development

# El esquema lo definen las migraciones (`npm run migrate`), no el arranque.
# El servidor se niega a arrancar si hay migraciones pendientes.

# ── Archivos subidos ──────────────────────────────────────────
# Carpeta donde la API guarda todo lo que sube la gente: adjuntos de páginas del sitio y
# de la intranet, y Excel de las cargas. Vacía = `filesystem/` en la raíz del repo,
# que git ignora. En el servidor es el volumen olo-app_filesystem y el compose ya la
# pone (/filesystem). Ver src/infrastructure/storage/filesystem.ts.
FILESYSTEM_DIR=

# URLs
FRONTEND_URL=http://localhost:3000
INTRANET_URL=http://localhost:3001

# ── Revalidación de caché al publicar ─────────────────────────
# Secreto compartido con el sitio web. Al aprobar una página, la API llama a
# POST {SITIO_WEB_URL}/api/revalidar para que el sitio tire su copia cacheada.
#
# SITIO_WEB_URL es la URL con la que la API alcanza al sitio desde el servidor: en Docker
# es el nombre del servicio (http://sitio-web:3000), no localhost ni el dominio público.
# Es distinta de FRONTEND_URL, que es el origen CORS del navegador.
#
# NO reutilizar JWT_SECRET: separados, una filtración de este solo permite vaciar caché.
# Generar con: openssl rand -hex 32
REVALIDAR_SECRET=
SITIO_WEB_URL=http://localhost:3000
# La intranet no cachea páginas publicadas, así que no hay nada que revalidar: se deja
# vacía hasta que alguna de sus páginas pase a ISR.
INTRANET_REVALIDAR_URL=

# ── Cuenta maestra local (solo desarrollo) ────────────────────
# Entra como Superadmin sin fila en la base: sin bloqueo por intentos, sin caducidad y
# sin rastro en la bitácora. Por eso con NODE_ENV=production se desactiva sola.
# Déjalas vacías si no la necesitas.
LOCAL_AUTH_EMAIL=
LOCAL_AUTH_PASSWORD=
LOCAL_AUTH_NAME=Superadmin
LOCAL_AUTH_ROLE=Superadmin

# ── Documentación OpenAPI (Swagger UI) ────────────────────────
# Visor interactivo en /api/docs y documento crudo en /api/docs.json.
#
# Fuera de producción está ENCENDIDA sin definir nada; pon 'false' para apagarla.
# En producción está APAGADA salvo que aquí ponga exactamente 'true': el documento
# describe la superficie entera de la API y no conviene regalarlo en un portal
# expuesto a internet. Detrás de una VPN o de una autenticación de nginx, encenderla
# es razonable.
#
# SWAGGER_RUTA cambia el punto de montaje si /api/docs choca con algo.
SWAGGER_HABILITADO=
SWAGGER_RUTA=/api/docs
